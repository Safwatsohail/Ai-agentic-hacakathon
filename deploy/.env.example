# Deployment state for the full Orchestr stack (backend + sandbox + db).
# Copy to repo root as `.env` and fill in real values:
#   cp deploy/.env.example .env
# Never commit the real `.env`.

# --- Postgres (used by docker-compose) ---
POSTGRES_PASSWORD=hackathon_secret
GOOGLE_CREDENTIALS_PATH=./google_credentials.json

# --- Discord ---
DISCORD_BOT_TOKEN=
DISCORD_INCIDENT_CHANNEL_ID=
DISCORD_DEV_CHANNEL_ID=

# --- Google Gemini (ADK agent) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- GitHub ---
GITHUB_TOKEN=
GITHUB_USERNAME=
GITHUB_TARGET_REPO=org/repo
GITHUB_PUSH_URL=https://<username>:<token>@github.com/org/repo.git

# --- Google Calendar service account (mounted read-only into both containers) ---
GOOGLE_APPLICATION_CREDENTIALS=/app/google_credentials.json
# Public calendar used for incident-review events (auto-created if missing).
# CALENDAR_SUMMARY=Orchestr Incident Reviews

# --- Backend / agent plumbing ---
BACKEND_URL=http://backend:8000
CORS_ORIGINS=http://localhost:3000
RUN_TIMEOUT_SECONDS=240

# --- GitHub Issue Watchdog (sandbox) ---
# How often the sandbox polls the target repo for new issues.
WATCH_INTERVAL_SECONDS=60
# Route bug/incident issues through the fix pipeline (PR + calendar review + dev notify).
AUTO_FIX_BUGS=true
# Post replies directly on the GitHub issue.
REPLY_ON_ISSUES=true
# Adapt reply tone to the reporter's observable public style.
ADAPT_REPLIES=true

# --- Frontend (optional; "" = same origin through the CRA dev proxy) ---
REACT_APP_API_BASE=